# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
DEMO_MODE=true
DEMO_OTP=123456            # whitelisted numbers only
DEMO_PHONES=               # comma-separated 10-digit numbers allowed to log in; * allows any (local dev only)
DEMO_ALLOW_ANY_NUMBER=false  # true: any valid mobile number signs in with DEMO_OTP (no SMS yet). Listed numbers still work. Nobody becomes admin while this is on.
ADMIN_PHONES=              # comma-separated numbers that also get the admin role at login (teacher verification); no wildcard
TRUST_PROXY=false          # set true when the API sits behind the Vite/Caddy proxy so rate limits see each phone's IP
JWT_SECRET=change-me   # outside dev: python -c "import secrets; print(secrets.token_urlsafe(48))"

# MongoDB Atlas
MONGODB_URI=
DB_NAME=khoj

# Languages: English is the base UI; Hindi and Marathi are voice languages
LANG_PRIMARY=hi
LANG_SECONDARY=mr

# Bhashini (exact variable names follow Bhashini's registration)
# Gnani Vachana: speech to text and text to speech (replaces Bhashini for now). Two keys: the first is
# used until it runs out of credit or quota, then the second. Leave both empty to use browser speech only.
GNANI_API_KEY_ID=
GNANI_API_KEY_ID_2=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=            # empty = Prisma v2.5 (tested); prisma-v3.0 is newer
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# LLM: Ollama (local) and Gemini (hosted), routed per task with failover
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=         # tested on the demo laptop: qwen2.5:3b (valid JSON, about 11 s cold on CPU)
OLLAMA_VISION_MODEL=       # a vision-capable model
OLLAMA_TIMEOUT_S=120
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=         # tested with this key: gemini-3.5-flash-lite (about 3 s). Check availability: GET /v1beta/models
GEMINI_VISION_MODEL=       # defaults to GEMINI_TEXT_MODEL when empty
LLM_MODE=cache_only        # cache_only | live. Set live to call Ollama and Gemini
LLM_ROUTE_EXTRACTION=ollama
LLM_ROUTE_DRAFTING=ollama
LLM_ROUTE_REASONING=ollama
LLM_ROUTE_INGESTION=gemini
LLM_ROUTE_TRANSLATION=gemini      # Hindi/Marathi answer -> English. Set to ollama to keep student speech on the laptop
VISION_ROUTE=ollama
PROOF_ROUTE=gemini         # teacher proof photos (certificates, work samples); student photos use VISION_ROUTE
VISION_FALLBACK_TO_GEMINI=false   # photos leave the laptop only if true

EMBEDDING_MODEL=intfloat/multilingual-e5-small
VERIFIED_MAX_DAYS=90
